				float time115 = (0.0 + (sin( ( lerpResult76 * _Frequency ) ) - -1.0) * (1.0 - 0.0) / (1.0 - -1.0));
				float2 panner122 = ( 0.3 * _Time.y * float2( 0,1 ) + texCoord11);
